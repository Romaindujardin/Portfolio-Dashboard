# ─────────────────────────────────────────────────────────────────────────────
# Déploiement public (Docker + Caddy)
# Copier ce fichier vers .env.production, puis remplacer le domaine et le mot
# de passe. Ne jamais committer .env.production.
# ─────────────────────────────────────────────────────────────────────────────

# Domaine public SANS https:// et sans slash final.
APP_DOMAIN=portfolio.example.com

# Origine publique de l'application (frontend + API sur le même serveur).
APP_URL=https://portfolio.example.com

# URL exacte à enregistrer dans Enable Banking (Production > Redirect URLs).
ENABLE_BANKING_REDIRECT_URI=https://portfolio.example.com/api/portfolio/connections/enable-banking/callback

# Écoute réseau. Docker doit écouter sur 0.0.0.0 pour être joignable par Caddy.
HOST=0.0.0.0
PORT=3001
SERVE_STATIC=true
TRUST_PROXY=1
DATABASE_PATH=/app/data/portfolio.db

# Protection HTTP Basic : obligatoire si l'application est publique.
# Choisir un mot de passe long et unique.
BASIC_AUTH_USER=portfolio
BASIC_AUTH_PASSWORD=change-me-with-a-long-random-password
REQUIRE_AUTH=true

# Enable Banking : recommandé en production pour ne pas dépendre de la config
# stockée en base. Monter la clé PEM dans ./secrets et renseigner le chemin.
# ENABLE_BANKING_APP_ID=00000000-0000-0000-0000-000000000000
# ENABLE_BANKING_PRIVATE_KEY_PATH=/app/secrets/enablebanking.pem
# ENABLE_BANKING_BASE_URL=https://api.enablebanking.com

# Optionnel : si le frontend et l'API sont sur des origines différentes.
# CORS_ORIGINS=https://portfolio.example.com

# Optionnel : clé de chiffrement des secrets. Si absente, une clé est générée
# dans /app/data/.portfolio-secret. Conserver cette clé avec la base : sans
# elle, les secrets déjà chiffrés (clé Enable Banking, etc.) sont illisibles.
# PORTFOLIO_SECRET_KEY=
