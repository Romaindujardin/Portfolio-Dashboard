{
  "name": "portfolio-tracker",
  "version": "1.0.0",
  "description": "Complete portfolio tracker for investments, crypto, and stocks",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx,ts,tsx",
    "type-check": "tsc --noEmit",
    "server": "node server.js",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "start:prod": "NODE_ENV=production node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:init": "node src/utils/database/init.js",
    "db:restore": "node restore-database.js"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "date-fns": "^2.29.3",
    "express": "^5.1.0",
    "lucide-react": "^0.344.0",
    "node-fetch": "^2.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.1",
    "recharts": "^2.5.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^3.1.0",
    "@vitest/coverage-v8": "^0.34.6",
    "autoprefixer": "^10.4.14",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.21",
    "tailwindcss": "^3.2.7",
    "typescript": "^5.4.5",
    "vite": "^4.1.0",
    "vitest": "^0.34.6"
  },
  "keywords": [
    "portfolio",
    "investment",
    "crypto",
    "stocks",
    "tracker"
  ],
  "author": "Your Name",
  "license": "MIT"
}
