# =====================================================
# Configuration du serveur (optionnel)
# =====================================================

# Optionnel : uniquement si le frontend et le backend sont sur deux origines
# différentes. En local, Vite proxyfie /api vers http://127.0.0.1:3001.
# En production mono-serveur, laisser vide (même origine).
# VITE_API_URL=https://api.example.com

# Port du serveur backend (défaut: 3001)
PORT=3001

# Interface d'écoute (défaut: 127.0.0.1). En Docker: 0.0.0.0.
# HOST=0.0.0.0

# En production, Express sert aussi le build Vite depuis dist/.
# SERVE_STATIC=true

# Protection HTTP Basic (fortement recommandée si exposé sur Internet).
# BASIC_AUTH_USER=portfolio
# BASIC_AUTH_PASSWORD=un-mot-de-passe-long
# REQUIRE_AUTH=true

# Chemins de données persistantes (Docker: /app/data/...)
# DATABASE_PATH=/app/data/portfolio.db

# URL du client, utilisée pour rediriger après le retour OAuth Enable Banking
# (défaut: https://localhost:5173). Enable Banking exige HTTPS
# pour l'URL de retour enregistrée dans l'application (supporté en dev via Vite SSL).
APP_URL=https://localhost:5173

# Clé de chiffrement des secrets d'intégration (AES-256-GCM).
# Si absente, une clé est générée dans data/.portfolio-secret (0600, gitignoré).
# PORTFOLIO_SECRET_KEY=

# Base Enable Banking (défaut: https://api.enablebanking.com)
# ENABLE_BANKING_BASE_URL=https://api.enablebanking.com

# Enable Banking : la configuration via l'interface est recommandée.
# Ces variables optionnelles sont prioritaires sur les valeurs stockées :
# ENABLE_BANKING_APP_ID=
# ENABLE_BANKING_PRIVATE_KEY_PATH=/chemin/vers/private.pem
# ENABLE_BANKING_REDIRECT_URI=https://localhost:5173/api/portfolio/connections/enable-banking/callback

# Optionnel : augmente les limites OpenFIGI pour la résolution ISIN.
# OPENFIGI_API_KEY=

# =====================================================
# Note: Ce fichier est OPTIONNEL !
#
# L'application fonctionne sans .env car les valeurs
# par défaut sont définies dans le code.
#
# Toutes les clés API (Binance, Gemini, Etherscan, etc.)
# sont configurables via l'interface utilisateur :
# Paramètres > Clés API
#
# Enable Banking se configure dans Patrimoine > Connexions :
# Application ID, clé privée PEM et URL de retour.
# La clé privée est chiffrée localement et jamais renvoyée
# au navigateur.
# =====================================================
